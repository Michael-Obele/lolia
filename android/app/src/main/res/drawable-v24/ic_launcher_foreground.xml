        android:fillColor="#191310"
        android:pathData="M25.425,33h6v36h19.2v6h-25.2z" />
    <!-- o: centre 67.575,60. Outer r 15, counter r 8.7. -->
    <path
        android:fillColor="#4F7DE0"
