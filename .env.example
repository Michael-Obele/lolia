# Lolia has no runtime environment.
#
# It is a static build: no server, no API keys, no database, no network at boot.
# Nothing in this file is read by the app. It exists for the one thing that
# genuinely needs a secret, which is the Cloudflare Pages deploy in CI.

# ---------------------------------------------------------------------------
# Cloudflare Pages — deploy only. Used by .github/workflows/deploy-web.yml
# ---------------------------------------------------------------------------
#
# Where to get the token:
#   https://dash.cloudflare.com/profile/api-tokens
#   -> Create Token
#   -> either the "Edit Cloudflare Workers" template, or a custom token with:
#        Account   ->  Cloudflare Pages  ->  Edit
#
# The token is a GitHub repo secret, never a committed value. Put the real one at:
#   GitHub -> the lolia repo -> Settings -> Secrets and variables -> Actions
#   -> New repository secret -> name it CLOUDFLARE_API_TOKEN
#
# This dummy value is here so the file documents the shape and nothing more.
CLOUDFLARE_API_TOKEN=dummy-not-a-real-token

# Where to get the account id:
#   https://dash.cloudflare.com  ->  Workers & Pages  ->  the right hand sidebar,
#   "Account details" -> Account ID
#
# Also a repo secret: CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=dummy-account-id

# The Pages project to create and publish to. Not a secret: safe to commit.
CLOUDFLARE_PROJECT_NAME=lolia
