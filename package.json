{
	"name": "lolia",
	"private": true,
	"version": "0.1.6",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prebuild": "bun run data:build",
		"data:build": "bun scripts/build-data.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run check:app && bun run check:scripts && bun run check:tests",
		"check:app": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
		"check:tests": "tsc --noEmit -p tests/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"version:sync": "bun scripts/sync-version.ts"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.12.4",
		"@types/bun": "^1.4.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"valibot": "^1.5.0",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/core": "^8.6.0",
		"@capacitor/haptics": "^8.0.2",
		"bits-ui": "^2.20.3",
		"layerchart": "^2.9.2",
		"svelte-idb": "^0.1.6"
	}
}
